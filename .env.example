# OKX API Configuration
OKX_API_KEY=your_okx_api_key
OKX_API_SECRET=your_okx_api_secret
OKX_PASSPHRASE=your_okx_passphrase
OKX_BASE_URL=https://www.okx.com

# Ethereum RPC Configuration (Infura/Alchemy)
ETH_RPC_URL=https://mainnet.infura.io/v3/your_infura_project_id
# 或者使用 Alchemy
# ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key

# 可选: 使用公共 RPC (不推荐用于生产环境)
# ETH_RPC_URL=https://eth.llamarpc.com

# Telegram Bot Configuration (可选，用于告警)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# 监控配置
CHECK_INTERVAL_MINUTES=1
MIN_SPREAD_PERCENTAGE=0.5
MIN_PROFIT_USD=10

# 测试资金规模 (ETH)
TEST_CAPITAL_ETH=1.5
